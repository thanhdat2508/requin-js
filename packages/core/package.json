{
  "name": "@requin/core",
  "version": "0.0.1",
  "type": "module",
  "description": "",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.8.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "author": "RequinJS",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0"
}
